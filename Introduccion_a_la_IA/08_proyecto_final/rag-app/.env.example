# Obtén tu propia clave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# La API utiliza el mismo modelo para documentos y preguntas.
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-3.6-flash

# Partición por palabras, similitud coseno y persistencia local.
CHUNK_WORDS=250
CHUNK_OVERLAP=50
MIN_SCORE=0.55
CHROMA_PATH=chroma

# Streamlit lee esta variable del entorno de su proceso.
# Si cambias la dirección, expórtala antes de iniciar la UI.
RAG_API_URL=http://localhost:8000
